DATABASE_URL=file:./dev.db
CALIBER_AUTH_USER=caliber
CALIBER_AUTH_SECRET=replace-with-a-long-random-password
# These credentials power Caliber's branded login and a signed 30-day session cookie.
# CALIBER_AUTH_SECRET is the initial login password. Optionally set a separate,
# long random CALIBER_SESSION_SECRET to sign session cookies and upload links;
# without it they are signed with CALIBER_AUTH_SECRET. Adding it later signs
# everyone out once.
CALIBER_SESSION_SECRET=
# Optional separate secret for encrypting an in-app OpenAI key.
# If omitted, CALIBER_AUTH_SECRET is used.
CALIBER_KEY_ENCRYPTION_SECRET=
OPENAI_API_KEY=sk-project-replace-me
OPENAI_MODEL=gpt-5.6-luna
AI_RATE_LIMIT_PER_MINUTE=10
MAX_IMAGE_BYTES=10485760
MAX_DOCUMENT_BYTES=20971520
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
# Minimum number of backups `npm run backup` / `db:push` keep when rotating
# (whole number 1-1000, default 14). Starts never prune. Backups younger than
# BACKUP_PRUNE_MIN_AGE_DAYS (default 7) are never pruned, and a start skips its
# backup if a verified one is younger than BACKUP_MIN_INTERVAL_MINUTES
# (default 10; 0 = always back up).
BACKUP_KEEP=14
# BACKUP_PRUNE_MIN_AGE_DAYS=7
# BACKUP_MIN_INTERVAL_MINUTES=10
# Production only: the volume mount. When set, the database, BACKUP_DIR and
# UPLOAD_DIR must all be inside it or the app refuses to start.
# DB_VOLUME_DIR=/app/data
# Production only: allow ONE deliberate first start with no database and no
# backups. Remove it as soon as that start succeeds.
# CALIBER_ALLOW_EMPTY_DB=1
ORPHAN_UPLOAD_TTL_HOURS=24
# Moving unreferenced uploads to UPLOAD_DIR/.orphans/ at startup is OFF unless
# this is 1 (npm run uploads:cleanup runs it by hand). It never deletes, and it
# refuses after a restore, with an empty database, or when more than
# CLEANUP_UPLOADS_MAX_FILES (20) or CLEANUP_UPLOADS_MAX_PERCENT (10) would move.
# CLEANUP_UPLOADS_ON_START=1
# CLEANUP_UPLOADS_DRY_RUN=1
